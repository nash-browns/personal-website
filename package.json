{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run images:sync",
    "dev": "next dev",
    "prebuild": "npm run images:sync",
    "build": "NODE_OPTIONS=--max_old_space_size=2048 next build",
    "start": "next start",
    "lint": "eslint app components lib firebase.js mdx-components.js next.config.mjs",
    "test:smoke": "node --test tests/framework-smoke.test.mjs",
    "test:bundles": "node --test tests/public-bundles.test.mjs",
    "images:sync": "node scripts/sync-article-images.mjs",
    "test:images": "node --test tests/article-images.test.mjs",
    "test:media": "node --test tests/article-media.test.mjs",
    "test:panorama": "node --experimental-vm-modules --test tests/panorama-viewer.test.mjs",
    "test:seo": "node --test tests/seo-metadata.test.mjs",
    "test:partners": "node --experimental-vm-modules --test tests/partner-correctness.test.mjs",
    "test:partners:emulator": "firebase emulators:exec --project demo-nashbrowns-security --only auth,firestore --config firebase.partners-test.json \"node --experimental-vm-modules --test tests/partner-emulator.test.mjs\"",
    "test:security": "npm run test:security:api && npm run test:security:rules",
    "test:security:api": "node --experimental-vm-modules --test tests/admin-access.test.mjs",
    "test:security:rules": "firebase emulators:exec --project demo-nashbrowns-security --only firestore \"node --test tests/firestore-rules.test.mjs\"",
    "postbuild": "next-sitemap"
  },
  "dependencies": {
    "@awesome.me/kit-237330da78": "^1.0.7",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.1",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@heroicons/react": "^2.1.3",
    "@mdx-js/loader": "^3.0.1",
    "@mdx-js/react": "^3.0.1",
    "@next/mdx": "16.3.4",
    "@next/third-parties": "16.3.4",
    "@tmcw/togeojson": "^5.8.1",
    "@types/mdx": "^2.0.13",
    "@vercel/analytics": "^1.3.1",
    "@vercel/speed-insights": "^1.0.11",
    "@vis.gl/react-google-maps": "^1.0.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^10.14.1",
    "firebase-admin": "^13.4.0",
    "mapbox-gl": "^3.6.0",
    "next": "16.3.4",
    "next-sitemap": "^4.2.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.60.0",
    "react-photo-view": "^1.2.4",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.0",
    "sharp": "^0.35.4",
    "three": "^0.173.0",
    "xmldom": "^0.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@mdx-js/mdx": "3.0.1",
    "@tailwindcss/typography": "^0.5.13",
    "autoprefixer": "^10.0.1",
    "daisyui": "^4.11.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "postcss": "^8",
    "tailwindcss": "^3.3.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
