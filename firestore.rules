rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email is string;
    }

    function hasUserProfile() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.token.email));
    }

    function userTenant() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.get('tenant', null);
    }

    function hasTenant() {
      return hasUserProfile()
        && (userTenant() is int || userTenant() is string)
        && string(userTenant()).size() > 0;
    }

    function isAdmin() {
      return hasTenant() && userTenant() in [0, '0'];
    }

    function belongsToTenant(tenant) {
      return hasTenant() && tenant == userTenant();
    }

    match /users/{email} {
      allow get: if (isAuthenticated() && request.auth.token.email == email)
        || isAdmin() || belongsToTenant(resource.data.tenant);
      allow list: if isAdmin() || belongsToTenant(resource.data.tenant);
      // Membership controls every other permission. Users must not grant themselves access.
      allow create, update, delete: if isAdmin();
    }

    match /tenants/{tenantId} {
      allow read: if isAdmin() || (hasTenant() && tenantId == string(userTenant()));
      allow create, update, delete: if isAdmin();
    }

    match /content/{contentId} {
      allow read: if isAdmin()
        || (hasTenant() && userTenant() in resource.data.tenant);
      allow create, update, delete: if isAdmin();
    }

    match /email_queue/{emailId} {
      allow read, write: if isAdmin();
    }

    function validContactRequest() {
      let data = request.resource.data;
      return data.keys().hasAll(['email', 'first_name', 'last_name', 'message', 'phone', 'type', 'site', 'created_at'])
        && data.keys().hasOnly(['email', 'first_name', 'last_name', 'message', 'phone', 'type', 'site', 'created_at'])
        && data.email is string && data.email.size() <= 254
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && data.first_name is string && data.first_name.size() > 0 && data.first_name.size() <= 100
        && data.last_name is string && data.last_name.size() > 0 && data.last_name.size() <= 100
        && data.message is string && data.message.size() > 0 && data.message.size() <= 10000
        && data.phone is string && data.phone.size() <= 50
        && data.type == 'work_with_us'
        && data.site == 'nash_browns'
        && data.created_at is timestamp;
    }

    match /incoming_request/{requestId} {
      allow create: if validContactRequest();
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
